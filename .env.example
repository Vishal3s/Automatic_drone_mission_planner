# Copy this file to .env and fill in real values.
# .env is git-ignored; .env.example is the template that gets committed.

# ---------------------------------------------------------------------------
# LLM configuration (Phase 3)
# ---------------------------------------------------------------------------
# Provider is swappable: "groq" (default), "ollama", or "openai" later,
# without touching any other module — everything reads through
# app/llm/llm_client.py.
LLM_PROVIDER=groq

# LLM_MODEL means something different per provider -- it's whatever model
# id that provider expects:
#   groq:   openai/gpt-oss-20b  (default -- fast, free tier, native
#           strict JSON-schema structured outputs; llama-3.3-70b-versatile
#           is a stronger/slower free-tier alternative if quality matters
#           more than speed)
#   ollama: qwen3:8b (needs ~6GB free RAM -- switch to qwen3:4b if that OOMs)
LLM_MODEL=openai/gpt-oss-20b

# Required when LLM_PROVIDER=groq. Get a free key at https://console.groq.com/keys
GROQ_API_KEY=

# Only used when LLM_PROVIDER=ollama (a local server, no API key needed)
OLLAMA_HOST=http://localhost:11434

# Only used if LLM_PROVIDER=openai (kept here so the .env shape doesn't
# change later; leave blank otherwise)
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# RAG configuration (Phase 2)
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION_NAME=drone_mission_docs
RAG_TOP_K=4

# ---------------------------------------------------------------------------
# Mission validation limits (Phase 5)
# ---------------------------------------------------------------------------
MIN_ALTITUDE_M=2
MAX_ALTITUDE_M=120
MAX_WAYPOINTS=50

# ---------------------------------------------------------------------------
# PX4 SITL / MAVSDK connection (Phase 6-8)
# ---------------------------------------------------------------------------
# udpin://0.0.0.0:14540 -- PX4 SITL's default MAVSDK-facing port, "listen
# on all interfaces" form. Verified against current MAVSDK docs in Phase 6
# (mavsdk.mavlink.io/main/en/cpp/guide/connections.html) -- the old bare
# "udp://:14540" form is NOT a documented scheme for mavsdk==3.17.2.
PX4_CONNECTION_URL=udpin://0.0.0.0:14540
PX4_CONNECT_TIMEOUT_S=30

# Cruise speed used for every converted MissionItem (m/s) -- our own
# Mission schema doesn't carry a per-waypoint speed (Phase 3/4 scope), but
# MAVSDK's MissionItem requires one. A documented assumption, not a
# verified spec value -- tune freely for your simulated vehicle.
MISSION_DEFAULT_SPEED_MS=5.0

# ---------------------------------------------------------------------------
# Database (Phase 10)
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/missions.db

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO

# --- Phase 15: Google Maps location resolution + mission map ---
# auto (default) = Google when GOOGLE_MAPS_API_KEY is set, else OpenStreetMap/Nominatim
LOCATION_PROVIDER=auto
# SERVER key (backend only, never sent to the browser). Enable "Places API (New)" and
# "Geocoding API"; restrict the key to those two APIs. Never commit the real value.
GOOGLE_MAPS_API_KEY=
# BROWSER key (Maps JavaScript API only). Visible to the browser by design, so use a
# SEPARATE key restricted by HTTP referrer to http://127.0.0.1:8765/* and http://localhost:8765/*
GOOGLE_MAPS_BROWSER_API_KEY=
# Map ID for Advanced Markers. DEMO_MAP_ID is Google's testing ID.
GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID
# Optional region bias, e.g. IN
GOOGLE_MAPS_REGION_CODE=
MAP_SERVER_PORT=8765

# --- Web UI: python -m app.api.main  (mission control in the browser) ---
UI_HOST=127.0.0.1
UI_PORT=8000
# Drone address the UI connects to (can also be changed in the page):
#   PX4 SITL: udpin://0.0.0.0:14540    Pixhawk over USB (Windows): serial://COM5:57600
PX4_CONNECTION_URL=udpin://0.0.0.0:14540

# --- Building outlines (Microsoft GlobalMLBuildingFootprints + OpenStreetMap) ---
# Order of outline sources; "off" disables outlines.
BUILDING_FOOTPRINT_PROVIDER=microsoft,openstreetmap
# Where downloaded Microsoft tiles are kept (one SQLite file per zoom-9 tile).
MS_FOOTPRINTS_CACHE_DIR=data/ms_footprints
# Ignore Microsoft footprints below this ML confidence (0 = keep all).
MS_FOOTPRINTS_MIN_CONFIDENCE=0

# --- Unknown building heights ---
# false (default) = still plan next to a building with no mapped height:
# assume UNKNOWN_BUILDING_ASSUMED_HEIGHT_M, keep the route that + roof
# clearance high there, and warn. true = refuse (old strict behaviour).
NEIGHBOUR_UNKNOWN_HEIGHT_BLOCKS=false
UNKNOWN_BUILDING_ASSUMED_HEIGHT_M=30
# false (default) = a leg below a neighbour's known height + roof clearance
# is a warning and the plan stays downloadable; true = reject the plan.
NEIGHBOUR_CLEARANCE_BLOCKS=false
